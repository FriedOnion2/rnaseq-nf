// =============================================================================
//  Nextflow 配置文件 / Configuration
//  含 Docker 执行器、资源标签、报告输出
// =============================================================================

params {
    max_cpus   = 8
    max_memory = '16.GB'
    max_time   = '72.h'
}

process {
    executor = 'docker'
    // 为每类任务定义资源上限，标签在模块内引用
    withLabel: process_low {
        cpus   = 1
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: process_medium {
        cpus   = 2
        memory = '8.GB'
        time   = '8.h'
    }
    withLabel: process_high {
        cpus   = 4
        memory = '16.GB'
        time   = '24.h'
    }
    withLabel: process_long {
        time = '72.h'
    }
}

docker {
    enabled = true
    // 中文环境友好提示：若拉取镜像失败，请先运行 docker pull
    runOptions = '--rm'
}

// 报告输出
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// 完成时清理工作目录占用的镜像层
cleanup = true

// 中文 / 文档提示
env {
    LANG = 'C.UTF-8'
}

// ---- 测试 profile（本地运行 / 快速校验接线）----
profiles {
    test {
        params {
            reads        = "${projectDir}/test/samplesheet_test.csv"
            genome_fasta = "${projectDir}/test/ref/genome.fa"
            gtf          = "${projectDir}/test/ref/genes.gtf"
            contrast     = 'treat,control'
        }
        process {
            executor = 'local'
            withLabel: process_low    { cpus = 1; memory = '1.GB' }
            withLabel: process_medium { cpus = 1; memory = '1.GB' }
            withLabel: process_high   { cpus = 1; memory = '2.GB' }
        }
    }
}